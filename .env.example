# ============================================================================
# Copy to .env.local for development. Never commit a filled-in file.
# Vercel: set the same keys per environment (Production / Preview / Development).
# ============================================================================

# --- Database -----------------------------------------------------------
# MySQL (Hostinger). See docs/DECISIONS.md ADR-018 for why MySQL and not the
# Neon Postgres the project started on.
#
# Get the four parts from hPanel → Databases → Management:
#   host      srvNNN.hstgr.io          (NOT localhost, unless the app runs
#                                       on the same host)
#   database  uNNNNNNNN_<name>
#   user      uNNNNNNNN_<name>
#   port      3306
#
# Remote access must be enabled first: hPanel → Databases → Remote MySQL, with
# the connecting IP added. A deployed app on a platform with no static egress
# IP cannot be allowlisted by address — read the note in ADR-018 before
# reaching for the `%` wildcard, which exposes the database to the internet.
#
# Percent-encode any of : / ? # [ ] @ in the password.
DATABASE_URL="mysql://user:password@srvNNN.hstgr.io:3306/dbname"

# --- Auth ---------------------------------------------------------------
# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Testing ------------------------------------------------------------
# Overrides the Playwright base URL when testing a deployed preview.
# PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"

# --- Email (session 2) --------------------------------------------------
# Resend. Two separate things:
#
#   RESEND_API_KEY  without it NOTHING is sent — the 2FA code and the reset
#                   link go to the server log instead, which is what lets a
#                   development machine run the flow with no key at all.
#   EMAIL_FROM      decides who can RECEIVE. The default below is Resend's
#                   sandbox sender and delivers only to the Resend account
#                   owner's own address, so it cannot be the production value:
#                   every account requires an emailed second factor, and a
#                   sender that reaches one person means one person can sign in.
#
# Production (OPEN_QUESTIONS Q5, answered session 3): pm.apqrinu-co.com is
# verified in Resend, so EMAIL_FROM="no-reply@pm.apqrinu-co.com" there.
#
# Do NOT set RESEND_API_KEY together with AUTH_MAIL_OUTBOX. `send()` does both:
# a test run with a key dispatches real email to the seed's fabricated
# addresses, which is a bounce rate that gets a sending domain throttled.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# --- Testing (session 2) ------------------------------------------------
# When set, every outgoing email is ALSO appended to this file as one JSON
# object per line. That is how the Playwright suite reads a verification code,
# because codes are stored hashed and cannot be read back from the database.
#
# The file contains live codes and reset links. Set it for a test run only,
# never in a deployed environment. See docs/OPEN_QUESTIONS.md Q18.
# AUTH_MAIL_OUTBOX=".playwright/outbox.jsonl"

# Overrides the seeded password used by `pnpm db:seed` and the E2E fixtures.
# SEED_PASSWORD="Nuwa!Ops2026x"

# ============================================================================
# Not installed yet. Each is added by the session that first needs it —
# see docs/01-TECH-STACK.md.
# ============================================================================

# Session 9 — task attachments (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=""

# Session 19 — daily digest cron (Vercel Cron calls a route with this header)
# CRON_SECRET=""
