# ============================================================================
# Copy to .env.local for development. Never commit a filled-in file.
# Vercel: set the same keys per environment (Production / Preview / Development).
# ============================================================================

# --- Database -----------------------------------------------------------
# Neon (Vercel Marketplace). Use the POOLED connection string for the app and
# the direct one for drizzle-kit migrations if they differ.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Auth ---------------------------------------------------------------
# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Testing ------------------------------------------------------------
# Overrides the Playwright base URL when testing a deployed preview.
# PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"

# ============================================================================
# Not installed yet. Each is added by the session that first needs it —
# see docs/01-TECH-STACK.md.
# ============================================================================

# Session 19 — notification email + daily digest (Resend)
# RESEND_API_KEY=""
# EMAIL_FROM="no-reply@example.com"

# Session 9 — task attachments (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=""

# Session 19 — daily digest cron (Vercel Cron calls a route with this header)
# CRON_SECRET=""
